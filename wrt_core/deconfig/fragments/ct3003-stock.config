# CT3003 stock (32MB 固件槽) 精简覆写 fragment
# 加载顺序在 proxy 之后（ini: CONFIG_FRAGMENTS=proxy,ct3003-stock）
# proxy.config 已设 passwall=y 且所有 INCLUDE=n；这里只按需开轻量内核

# 服务只保留 passwall：关闭 openclash（覆盖 compile_base.config）
CONFIG_PACKAGE_luci-app-openclash=n

# passwall 轻量内核：仅 shadowsocks-libev 客户端（约 1MB，替代 sing-box 的 20MB+）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=y

# 其余大体积内核保持关闭（proxy.config 默认 n，此处显式确保）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_xray-plugin=n

# 硬件加速：nftables 流卸载（体积小，保留）
CONFIG_PACKAGE_kmod-nft-offload=y

# 关闭 compile_base 中的大体积非必需应用，适配 32MB 固件槽
CONFIG_PACKAGE_luci-app-store=n
CONFIG_PACKAGE_luci-app-mini-diskmanager=n
CONFIG_PACKAGE_luci-app-tingreader=n
CONFIG_PACKAGE_luci-i18n-tingreader-zh-cn=n
CONFIG_PACKAGE_luci-app-quickstart=n
CONFIG_PACKAGE_quickstart=n
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=n
CONFIG_PACKAGE_coremark=n
# 注意：argon/aurora 主题是 compile_base 的必需项，build.sh 会校验，不可关闭
